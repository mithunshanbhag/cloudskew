.landing-page {
    font-family: "Segoe UI","Helvetica Neue","Helvetica",Arial,sans-serif;
}

/* notification banner section */

.landing-page-notification-banner {
    background-color: whitesmoke;
    text-align: center;
    font-size: 85%;
}

.landing-page-notification-banner > p {
    margin: 1px auto;
}

/* menu section */

.landing-page-menu {
    background-color: #373277;    
}

/* hero section */

.landing-page-hero {
    min-height: 500px;
}

.landing-page-feature-image {
    padding: 10px;
    flex-basis: auto;
    max-width: 40%;
}

.landing-page-hero-text {
    max-width: 30%;
    margin-left: 30px;
}

.landing-page-hero-header {
    font-size: x-large;
}

.landing-page-hero-subheader {
    font-size: large;    
}

.landing-page-hero-description {
}

.landing-page-hero-cta-button {
    /* without this, the button occupies full 
    div width for some reason */
    margin: 0 auto; 
}

/* features section */

.landing-page-features-overview {
    min-height: 100px;
    text-align: center;
    background-color: whitesmoke;
}

.landing-page-feature {
    background-color: white;
}

.landing-page-feature-image {
    padding: 10px;
    flex-basis: auto;
    max-width: 20%;
}

.landing-page-feature-text {
    max-width: 50%;
}

.landing-page-feature-header {
    font-size: x-large;    
}

.landing-page-feature-description {
    max-width: auto;
}

/* social proof section */

.landing-page-social-proof {
    background-color:whitesmoke;
    min-height: 250px;
}

/* pricing section */

.landing-page-pricing {
    min-height: 400px;
}

/* footer section */

.landing-page-footer {
    background-color: #373277;
    font-family: 'Roboto Mono', monospace;
    color: whitesmoke;
}