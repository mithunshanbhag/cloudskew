    <!-- social proof section -->
    <a name="testimonials"></a>
    <div class="landing-page-social-proof"></div>

    <!-- pricing section -->
    <a name="pricing"></a>
    <div class="landing-page-pricing">
    </div>

    <!-- footer section -->
    <a name="footer"></a>
    <div class="navbar navbar-expand navbar-dark justify-content-center landing-page-footer">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link active" href="#">item1</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">item2</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">item3</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">item4</a>
