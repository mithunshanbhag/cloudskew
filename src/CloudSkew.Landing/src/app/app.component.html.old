<div class="landing-page">

    <!-- notification banner section -->
    <div class="landing-page-notification-banner">
        <p>Qui eu minim dolor elit dolor quis ad reprehenderit
            exercitation exercitation nisi.</p>
    </div>

    <!-- menu section -->
    <nav class="navbar navbar-expand navbar-dark justify-content-center py-0 landing-page-menu">
        <a class="navbar-brand" href="#">NAVBAR-BRAND</a>
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" href="/welcome#features">FEATURES</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/welcome#testimonials">TESTIMONIALS</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/welcome#pricing">PRICING</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" [href]="this.appUrl">LOGIN</a>
            </li>
        </ul>
    </nav>

    <!-- hero section -->
    <div class="d-flex justify-content-center align-items-center landing-page-hero">
        <img [src]="this.landingPageHeroUrl" alt="test" class="landing-page-hero-image" />
        <div class="d-flex flex-column landing-page-hero-text">
            <p class="text-center landing-page-hero-header">Non reprehenderit commodo</p>
            <p class="text-center landing-page-hero-subheader">Et mollit in et ullamco</p>
            <p class="landing-page-hero-description">In duis velit voluptate eu culpa laborum. Et enim ea qui non
                adipisicing nulla culpa esse dolore ea nulla elit occaecat.</p>
            <button type="button" class="btn btn-success landing-page-hero-cta-button">GET STARTED</button>
        </div>
    </div>

    <!-- features section -->
    <a name="features"></a>
    <div class="d-flex justify-content-center align-items-center landing-page-features-overview">
        <p class="col">feature1</p>
        <p class="col">feature2</p>
        <p class="col">feature3</p>
    </div>

    <div class="d-flex justify-content-center align-items-center landing-page-feature">
        <img [src]="this.landingPageFeature1Url" alt="test" class="landing-page-feature-image" />
        <div class="d-flex flex-column landing-page-feature-text">
            <p class="landing-page-feature-header">feature1 header</p>
            <p class="landing-page-feature-description">Incididunt in aute duis amet ipsum ea laborum. Non aliquip
                occaecat proident cillum officia aliqua reprehenderit consequat esse ullamco laborum occaecat.
                Consectetur ex qui tempor cupidatat do dolor. Quieiusmod aliqua non dolore cillum do officia proident
                incididunt nisi cupidatat dolor.</p>
        </div>
    </div>

    <div class="d-flex justify-content-center align-items-center landing-page-feature">
        <div class="d-flex flex-column landing-page-feature-text">
            <p class="landing-page-feature-header">feature2 header</p>
            <p class="landing-page-feature-description">Sit eiusmod ullamco ex velit fugiat commodo tempor adipisicing
                commodo. Laboris reprehenderit ad sunt voluptate anim anim aliquip enim esse ullamco sint. Quis ullamco
                excepteur cillum voluptate ullamco aliqua veniam dolore aliqua reprehenderit. Ullamco voluptate aliquip
                tempor ex. Cupidatat sit sit Lorem ad enim reprehenderit. Elit adipisicing esse cupidatat excepteur
                adipisicing dolor et Lorem proident veniam sunt. Dolor aliqua Lorem occaecat non pariatur laborum ad
                reprehenderit.</p>
        </div>
        <img [src]="this.landingPageFeature1Url" alt="test" class="landing-page-feature-image" />
    </div>

    <div class="d-flex justify-content-center align-items-center landing-page-feature">
        <img [src]="this.landingPageFeature1Url" alt="test" class="landing-page-feature-image" />
        <div class="d-flex flex-column landing-page-feature-text">
            <p class="landing-page-feature-header">feature3 header</p>
            <p class="landing-page-feature-description">Ea velit laboris proident consequat aliqua eiusmod ullamco sint
                id incididunt. Dolore voluptate et velit ad ut et amet. Laborum et duis ut pariatur amet tempor ullamco
                dolor excepteur esse et voluptate. Dolor et minim aliqua ad laborum cillum deserunt deserunt aliqua ea
                minim eu sunt. Minim ea cillum ut pariatur deserunt adipisicing officia consequat fugiat officia anim
                occaecat Lorem magna. Ullamco sint do dolore ex aliquip aute ad amet velit dolor exercitation quis
                deserunt incididunt.</p>
